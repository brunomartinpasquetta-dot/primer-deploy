  function cargarHistorialInline() {
    var tbody = document.getElementById('tbody-hist-completo');
    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:20px;color:var(--texto-suave);">Cargando...</td></tr>';
    var tid = (window.temporadaActiva && window.temporadaActiva.id) || '';
    var desde = document.getElementById('hist-j-desde').value;
    var hasta = document.getElementById('hist-j-hasta').value;
    var params = [];
    if (tid)   params.push('temporada_id=' + tid);
    if (desde) params.push('desde=' + desde);
    if (hasta) params.push('hasta=' + hasta);
    fetch('/api/juntada/historial' + (params.length ? '?' + params.join('&') : ''))
      .then(function(r) { return r.json(); })
      .then(function(data) {
        _historialData = data;
        filtrarHistorialInline();
      })
      .catch(function() {
        tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:20px;color:#c0392b;">Error al cargar</td></tr>';
      });
  }

  function filtrarHistorialInline() {
    var tbody = document.getElementById('tbody-hist-completo');
    var q = (document.getElementById('hist-j-buscar').value || '').trim().toLowerCase();
    var data = _historialData;
    if (q) {
      data = data.filter(function(r) {
        return (r.cosechero || '').toLowerCase().indexOf(q) >= 0 ||
               (r.parcela || '').toLowerCase().indexOf(q) >= 0 ||
               (r.usuario || '').toLowerCase().indexOf(q) >= 0 ||
               (r.temporada || '').toLowerCase().indexOf(q) >= 0;
      });
    }
    if (!data.length) {
      tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:20px;color:var(--texto-suave);">Sin registros</td></tr>';
      return;
    }
    var fmtFH = function(iso) { if (!iso) return '—'; var d = new Date(iso); return d.toLocaleDateString('es-AR') + ' ' + d.toLocaleTimeString('es-AR',{hour:'2-digit',minute:'2-digit'}); };
    var mono = "font-family:'JetBrains Mono',monospace;";
    tbody.innerHTML = data.map(function(r) {
      var esAnulada = !!r.anulada;
      var trClass = esAnulada ? ' class="row-anulada"' : '';
      var acciones = esAnulada
        ? '<span class="badge-anulada">Anulada</span>'
        : '<button class="btn-icon" title="Editar" onclick="editarJuntada(' + r.id + ')"><i data-lucide="pencil"></i></button>' +
          '<button class="btn-icon-danger" title="Anular" onclick="anularJuntada(' + r.id + ')"><i data-lucide="ban"></i></button>';
      return '<tr' + trClass + '>' +
        '<td style="' + mono + 'font-size:11px;color:var(--texto-suave);">#' + r.id + '</td>' +
        '<td style="font-size:12px;font-weight:600;">' + (r.cosechero || '—') + '</td>' +
        '<td style="font-size:12px;">' + fmtFH(r.fecha) + '</td>' +
        '<td style="font-size:12px;">' + (r.parcela || '—') + '</td>' +
        '<td style="' + mono + 'text-align:right;font-weight:700;color:var(--sem-verde);">' + parseFloat(r.kilos||0).toLocaleString('es-AR',{minimumFractionDigits:2}) + ' kg</td>' +
        '<td style="font-size:11px;color:var(--texto-suave);">' + (r.usuario || '—') + '</td>' +
        '<td style="font-size:11px;color:var(--texto-suave);">' + (r.temporada || '—') + '</td>' +
        '<td style="text-align:center;white-space:nowrap;">' + acciones + '</td>' +
      '</tr>';
    }).join('');
    lucide.createIcons();
  }

  // ── TOTALES POR COSECHERO ─────────────────────────────────────────
  function cargarTotalesJuntador() {
    var tbody = document.getElementById('tbody-totales-juntador');
    tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:20px;color:var(--texto-suave);">Cargando...</td></tr>';
    var tid = (window.temporadaActiva && window.temporadaActiva.id) || '';
    fetch('/api/juntada/totales-por-juntador' + (tid ? '?temporada_id=' + tid : ''))
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (!data.length) {
          tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:20px;color:var(--texto-suave);">Sin registros</td></tr>';
          return;
        }
        var mono = "font-family:'JetBrains Mono',monospace;";
        var totalKg = data.reduce(function(s,r){ return s + parseFloat(r.kg_total||0); }, 0);
        var totalReg = data.reduce(function(s,r){ return s + parseInt(r.registros||0); }, 0);
        tbody.innerHTML = data.map(function(r) {
          return '<tr>' +
            '<td style="font-weight:700;">' + (r.cosechero || '—') + '</td>' +
            '<td style="' + mono + 'text-align:center;">' + r.registros + '</td>' +
            '<td style="' + mono + 'text-align:right;font-weight:700;color:var(--sem-verde);">' + parseFloat(r.kg_total||0).toLocaleString('es-AR',{minimumFractionDigits:2}) + ' kg</td>' +
            '<td style="font-size:11px;color:var(--texto-suave);">' + (r.primera_fecha ? new Date(r.primera_fecha).toLocaleDateString('es-AR') : '—') + '</td>' +
            '<td style="font-size:11px;color:var(--texto-suave);">' + (r.ultima_fecha ? new Date(r.ultima_fecha).toLocaleDateString('es-AR') : '—') + '</td>' +
          '</tr>';
        }).join('');
        tbody.innerHTML += '<tr style="background:var(--fondo-dark);font-weight:700;">' +
          '<td>TOTAL</td><td style="text-align:center;' + mono + '">' + totalReg + '</td>' +
          '<td style="text-align:right;' + mono + 'color:var(--sem-verde);">' + totalKg.toLocaleString('es-AR',{minimumFractionDigits:2}) + ' kg</td>' +
          '<td colspan="2"></td></tr>';
      })
      .catch(function() {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:20px;color:#c0392b;">Error al cargar</td></tr>';
      });
  }

  // ── ANULAR JUNTADA ───────────────────────────────────────────────
  function anularJuntada(id) {
    var motivo = prompt('Motivo de anulación:');
    if (!motivo) return;
    if (!confirm('¿Anular juntada #' + id + '? Se revertirán los movimientos de stock.')) return;
    fetch('/api/juntada/' + id + '/anular', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ motivo: motivo })
    }).then(function(r) { return r.json(); }).then(function(data) {
      if (data.ok) { cargarHistorial(); cargarHistorialInline(); }
      else { alert('Error: ' + (data.error || 'No se pudo anular')); }
    }).catch(function() { alert('Error de conexión'); });
  }

