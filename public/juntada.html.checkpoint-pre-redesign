<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#1A2E0A">
  <title>Cosecha — Campo</title>
  <link rel="icon" href="img/logo.png">
  <script src="js/utils.js"></script>
  <script src="js/movimientos-grid.js"></script>
  <link rel="stylesheet" href="cosecha.css">
  <script src="js/auth-check.js"></script>
  <style>
    .destino-section {
      border: 1.5px solid #e0e0e0;
      border-radius: 12px;
      margin-bottom: 12px;
      overflow: hidden;
    }
    .destino-header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 16px;
      cursor: pointer;
      background: #f9f9f9;
      user-select: none;
    }
    .destino-header:hover { background: #f0f0f0; }
    .destino-toggle {
      width: 22px; height: 22px;
      border: 2px solid #ccc;
      border-radius: 6px;
      display: flex; align-items: center; justify-content: center;
      font-size: 16px; font-weight: bold; color: #999;
      flex-shrink: 0;
    }
    .destino-section.enabled .destino-toggle {
      background: #2D5016; border-color: #2D5016; color: white;
    }
    .destino-section.enabled .destino-header { background: #f0f4e8; }
    .destino-body {
      display: none;
      padding: 14px 16px;
      border-top: 1px solid #e0e0e0;
      background: white;
    }
    .destino-section.enabled .destino-body { display: block; }

    .kilos-badge {
      background: #2D5016;
      color: white;
      border-radius: 20px;
      padding: 2px 12px;
      font-size: 14px;
      font-weight: bold;
      margin-left: auto;
    }
    .kilos-restantes {
      text-align: center;
      font-size: 14px;
      color: #666;
      padding: 8px;
      background: #f9f9f9;
      border-radius: 8px;
      margin-bottom: 12px;
    }
    .kilos-restantes.ok { color: #2d6a4f; background: #e8f5e2; }
    .kilos-restantes.error { color: #c0392b; background: #fde8e8; }

    #resumen-kilos {
      font-size: 18px;
      font-weight: bold;
      color: #2D5016;
      text-align: center;
      margin-bottom: 16px;
    }

    /* ── Layout dos columnas ── */
    .juntada-layout {
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 16px;
      align-items: start;
    }
    .juntada-form { min-width: 0; max-width: 220px; position: relative; z-index: 2; }

    /* ── Compactación panel izquierdo ── */
    .juntada-form .card-form { padding: 10px 12px; margin-bottom: 8px; }
    .juntada-form label { font-size: 11px !important; margin-bottom: 4px; }
    .juntada-form .form-row { margin-bottom: 8px; }
    .juntada-form select { height: 34px !important; font-size: 13px !important; padding: 4px 8px !important; }
    .juntada-form .destino-form-inner input[type="number"] { width: 60% !important; height: 34px !important; font-size: 13px !important; padding: 4px 8px !important; }
    .juntada-form .destino-form-inner select { height: 34px !important; font-size: 13px !important; }
    .juntada-form .cosechador-modos { gap: 4px; margin-bottom: 6px; }
    .juntada-form .modo-btn { padding: 5px 4px; font-size: 11px; min-height: 28px; }
    .juntada-form .juntador-chip { padding: 8px 10px; margin-top: 8px; }
    .juntada-form #btn-registrar { height: 40px; font-size: 14px !important; padding: 8px 16px; width: 100%; }
    .juntada-historial {
      background: var(--superficie);
      border: 1px solid var(--borde);
      border-radius: 12px;
      overflow: hidden;
      position: relative;
      z-index: 1;
    }
    /* Grilla movimientos compacta con columnas auto-ajustables */
    .juntada-historial table {
      table-layout: auto;
      width: 100%;
    }
    .juntada-historial th {
      padding: 6px 8px;
      font-size: 10px;
      white-space: nowrap;
    }
    .juntada-historial td {
      padding: 5px 8px;
      font-size: 12px;
      white-space: nowrap;
    }
    .juntada-historial-header {
      padding: 14px 16px 12px;
      border-bottom: 1px solid var(--borde);
      display: flex;
      align-items: baseline;
      gap: 8px;
    }
    .juntada-historial-header h3 {
      font-size: 14px;
      font-weight: 700;
      color: var(--texto);
      margin: 0;
    }
    .juntada-historial-header small {
      font-size: 12px;
      color: var(--texto-suave);
      font-family: 'JetBrains Mono', monospace;
    }
    .juntada-historial-body {
      overflow-y: auto;
      max-height: 520px;
    }
    .juntada-historial-body table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    .juntada-historial-body th {
      text-align: left;
      padding: 8px 12px;
      font-size: 11px;
      font-weight: 600;
      color: var(--texto-suave);
      background: var(--fondo);
      text-transform: uppercase;
      letter-spacing: .5px;
      position: sticky;
      top: 0;
    }
    .juntada-historial-body td {
      padding: 9px 12px;
      border-bottom: 1px solid var(--borde);
      color: var(--texto);
    }
    .juntada-historial-body tr:last-child td { border-bottom: none; }
    .juntada-historial-body tr:hover td { background: var(--fondo); }
    .juntada-historial-footer {
      padding: 10px 12px;
      border-top: 1px solid var(--borde);
      font-size: 12px;
      font-weight: 600;
      color: var(--texto-suave);
      background: var(--fondo);
      display: flex;
      justify-content: flex-end;
      gap: 4px;
    }
    .juntada-historial-footer span { color: var(--verde); font-family: 'JetBrains Mono', monospace; }
    .hist-vacio {
      padding: 32px 16px;
      text-align: center;
      color: var(--texto-suave);
      font-size: 13px;
    }
    .dest-badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 10px;
    }
    .dest-badge.deposito { background: var(--sem-azul-bg); color: var(--sem-azul); }
    .dest-badge.venta { background: var(--sem-verde-bg); color: var(--sem-verde); }
    .dest-badge.descarte { background: var(--sem-rojo-bg); color: var(--sem-rojo); }
    .dest-badge.sin { background: var(--sem-gris-bg); color: var(--sem-gris); }

    /* ── Cosechador modos ── */
    .cosechador-modos { display:flex; gap:8px; margin-bottom:10px; }
    .modo-btn {
      flex:1; padding:10px 8px; border:2px solid var(--borde); border-radius:8px;
      background:var(--fondo); color:var(--texto-2); font-size:13px; font-weight:600;
      cursor:pointer; display:flex; align-items:center; justify-content:center; gap:6px;
      transition:all .15s;
    }
    .modo-btn.active { border-color:var(--verde); background:var(--verde-suave); color:var(--verde); }
    /* ── Juntador chip ── */
    .juntador-chip {
      display:flex; align-items:center; gap:8px; margin-top:10px;
      background:var(--sem-verde-bg); border:1px solid var(--sem-verde-borde);
      border-radius:8px; padding:10px 12px; color:var(--sem-verde);
    }
    .juntador-chip strong { flex:1; font-size:14px; }
    .juntador-chip-clear { background:none; border:none; cursor:pointer; color:var(--sem-verde); font-size:16px; padding:0 4px; }
    /* ── Kilos input grande ── */
    .kilos-input-wrap { display:flex; flex-direction:column; align-items:stretch; padding:4px 0 2px; }
    .kilos-input-grande {
      width:100% !important; height:64px !important; text-align:center !important;
      font-size:40px !important; font-weight:700 !important; line-height:64px !important;
      font-family:'JetBrains Mono',monospace !important; color:#2D5016 !important;
      border:2px solid #2D5016 !important; border-radius:8px !important;
      padding:0 !important; background:#fff !important;
      box-sizing:border-box; -moz-appearance:textfield; appearance:textfield;
      transition:border-color .2s;
    }
    .kilos-input-grande::-webkit-outer-spin-button,
    .kilos-input-grande::-webkit-inner-spin-button { -webkit-appearance:none; margin:0; }
    .kilos-input-grande:focus { outline:none; border-color:#1a3a0a !important; }
    .kilos-unidad { font-size:16px; font-weight:600; color:#2D5016; margin-top:2px; text-align:center; }
    /* ── Destino tipo grid ── */
    .destino-tipo-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin:10px 0; }
    .destino-tipo-btn {
      border:2px solid var(--borde); border-radius:8px; background:var(--superficie);
      cursor:pointer; height:34px; padding:0 10px; display:flex; flex-direction:row;
      align-items:center; justify-content:center; gap:6px; font-size:13px; font-weight:600; color:var(--texto-2);
      transition:all .15s;
    }
    .destino-tipo-btn:hover { border-color:var(--verde); background:var(--verde-suave); }
    .destino-tipo-btn.active { border-color:var(--verde); background:var(--verde-suave); color:var(--verde); }
    .destino-btn-icon { font-size:16px; }
    /* ── KG total badge ── */
    .kg-total-badge {
      text-align:center; font-size:17px; font-weight:700; color:var(--verde);
      font-family:'JetBrains Mono',monospace; padding:8px; background:var(--verde-suave);
      border-radius:8px; margin-bottom:6px;
    }
    /* ── Kilos restantes alerta ── */
    .kilos-restantes-alerta {
      background:var(--sem-amarillo-bg); border:1px solid var(--sem-amarillo-borde);
      color:#7a5c00; border-radius:8px; padding:10px 14px;
      font-size:13px; font-weight:600; margin:10px 0 4px;
    }
    .destino-form-inner { background:var(--fondo); border-radius:10px; padding:12px; margin-top:4px; }

    /* ── Barra de lote ── */
    .lote-bar {
      display:flex; align-items:center; gap:12px; padding:10px 16px;
      background:var(--superficie); border:1.5px solid var(--borde); border-radius:10px;
      margin-bottom:12px; flex-wrap:wrap;
    }
    .lote-bar-codigo {
      font-family:'JetBrains Mono',monospace; font-size:15px; font-weight:700;
      color:var(--texto); background:var(--fondo); border:1px solid var(--borde);
      border-radius:6px; padding:6px 14px;
    }
    .lote-bar .btn-iniciar {
      display:flex; align-items:center; gap:6px;
      padding:8px 16px; border-radius:8px; font-size:13px; font-weight:700;
      background:var(--verde); color:white; border:none; cursor:pointer;
    }
    .lote-bar .btn-iniciar:hover { background:#1f3d0f; }
    .lote-bar .btn-cerrar-lote {
      display:flex; align-items:center; justify-content:center; gap:8px;
      padding:12px 24px; border-radius:10px; font-size:15px; font-weight:700;
      background:var(--verde); color:white; border:none; cursor:pointer; margin-left:auto;
      min-height:44px; box-shadow:0 2px 8px rgba(45,80,22,.18);
      transition: filter .13s, transform .1s;
    }
    .lote-bar .btn-cerrar-lote:hover { filter:brightness(.88); }
    .lote-bar .btn-cerrar-lote:active { transform:scale(.985); }
    .lote-bar select {
      height:36px; font-size:13px; border:1.5px solid var(--borde); border-radius:8px;
      padding:4px 10px; margin-left:auto;
    }

    /* ── KPI cards ── */
    .juntada-kpis {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-bottom: 12px;
    }
    .juntada-kpi {
      background: white;
      border: 1px solid var(--borde);
      border-top: 3px solid var(--verde);
      border-radius: 8px;
      padding: 6px 8px;
      text-align: center;
    }
    .juntada-kpi-label {
      font-size: 9px;
      font-weight: 700;
      color: var(--texto-suave);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 2px;
    }
    .juntada-kpi-valor {
      font-size: 16px;
      font-weight: 700;
      color: var(--verde);
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: -0.5px;
    }
    @media (max-width: 600px) { .juntada-kpis { grid-template-columns: 1fr 1fr; } }

    /* ── Lote mode: juntadores grid ── */
    .juntada-layout.lote-mode { grid-template-columns: minmax(0,420px) 1fr; }
    .btn-pesaje {
      display:inline-flex; align-items:center; gap:4px;
      padding:5px 10px; border-radius:6px; font-size:11px; font-weight:700;
      background:var(--verde); color:white; border:none; cursor:pointer; transition:.15s;
    }
    .btn-pesaje:hover { background:#1f3d0f; }
    .btn-detalle {
      display:inline-flex; align-items:center; gap:4px;
      padding:5px 10px; border-radius:6px; font-size:11px; font-weight:600;
      background:var(--fondo); color:var(--texto-secundario); border:1px solid var(--borde);
      cursor:pointer; transition:.15s;
    }
    .btn-detalle:hover { background:var(--borde); color:var(--texto); }
    .btn-add-junt {
      display:flex; align-items:center; gap:4px;
      padding:6px 12px; border-radius:8px; font-size:12px; font-weight:700;
      background:var(--verde); color:white; border:none; cursor:pointer;
    }
    .btn-add-junt:hover { background:#1f3d0f; }
    .add-junt-form { display:none; }
    .add-junt-form.open { display:flex; }

    @media (max-width: 900px) {
      .juntada-layout { grid-template-columns: 1fr; }
      .juntada-layout.lote-mode { grid-template-columns: 1fr; }
      .juntada-form { max-width: 100%; }
      .juntada-historial { order: 2; }
      .juntada-form { order: 1; }
    }
  </style>
</head>
<body>
<div class="app-shell">

  <!-- ── SIDEBAR ── -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <img src="img/logo-icon.png" style="height:44px; width:44px; border-radius:10px;"><div style="margin-left:10px; display:flex; flex-direction:column; justify-content:center; line-height:1.1;"><span style="color:white; font-weight:700; font-size:18px;">CO<span style="color:#F5A623;">SE</span>CHA</span><span style="color:rgba(255,255,255,0.5); font-size:10px; letter-spacing:1.5px; margin-top:2px;">SISTEMA DE CULTIVOS</span></div>
    </div>
    <nav class="sidebar-nav">
      <a href="index.html" class="nav-item">
        <span class="nav-icon"><i data-lucide="layout-dashboard"></i></span> Dashboard
      </a>
      <div class="nav-section">Campo</div>
      <a href="juntada.html" class="nav-item active">
        <span class="nav-icon"><i data-lucide="wheat"></i></span> Cosecha
      </a>
      <a href="despalillado.html" class="nav-item">
        <span class="nav-icon"><i data-lucide="scissors"></i></span> Despalillado
      </a>
      <a href="aplicaciones.html" class="nav-item">
        <span class="nav-icon"><i data-lucide="droplets"></i></span> Aplicaciones
      </a>
      <div class="nav-section">Sistema</div>
      <a href="menu-stock.html" class="nav-item">
        <span class="nav-icon"><i data-lucide="package"></i></span> Stock
      </a>
      <a href="menu-comercial.html" class="nav-item">
        <span class="nav-icon"><i data-lucide="users"></i></span> Comercial
      </a>
      <a href="menu-admin.html" class="nav-item">
        <span class="nav-icon"><i data-lucide="landmark"></i></span> Administración
      </a>
      <a href="mercado.html" class="nav-item">
        <span class="nav-icon"><i data-lucide="trending-up"></i></span> Mercado
      </a>
      <a href="menu-config.html" class="nav-item">
        <span class="nav-icon"><i data-lucide="settings"></i></span> Configuración
      </a>
    </nav>
    <div class="sidebar-footer">Sistema Agrícola v2</div>
  </aside>

  <!-- ── MAIN ── -->
  <div class="main">
    <header class="topbar">
      <div class="topbar-left" style="display:flex;align-items:center;gap:10px;">
        <img src="img/logo-icon.png" style="height:44px; width:44px; border-radius:10px;"><div style="margin-left:10px; display:flex; flex-direction:column; justify-content:center; line-height:1.1;"><span style="color:white; font-weight:700; font-size:18px;">CO<span style="color:#F5A623;">SE</span>CHA</span><span style="color:rgba(255,255,255,0.5); font-size:10px; letter-spacing:1.5px; margin-top:2px;">SISTEMA DE CULTIVOS</span></div><span id="temporada-activa-badge" class="temporada-badge">Cargando...</span>
      </div>
      <div class="topbar-right">
        <span class="topbar-date" id="topbar-date"></span>
      </div>
    </header>

    <div class="content">
      <a href="menu-campo.html" class="btn-volver">← Volver</a>
      <div class="content-header">
        <div class="content-title">Registrar juntada</div>
        <div class="content-sub">Seleccioná el parcela, escaneá el cosechador y confirmá el peso</div>
      </div>

      <!-- ── Barra de lote ── -->
      <div class="lote-bar" id="lote-bar">
        <!-- Sin lote activo -->
        <div id="lote-sin-activo">
          <button class="btn-iniciar" onclick="iniciarJuntada()">
            <i data-lucide="play" style="width:16px;height:16px;"></i> Iniciar juntada
          </button>
        </div>
        <!-- Con lote activo -->
        <div id="lote-activo" style="display:none;width:100%;">
          <div style="display:flex;align-items:center;gap:12px;width:100%;flex-wrap:wrap;">
            <span class="lote-bar-codigo" id="lote-codigo"></span>
            <div style="margin-left:auto;display:flex;align-items:center;gap:10px;">
              <div style="display:flex;align-items:center;gap:6px;">
                <i data-lucide="warehouse" style="width:16px;height:16px;color:var(--texto-suave);flex-shrink:0;"></i>
                <select id="sel-galpon" style="height:38px;font-size:13px;border:1.5px solid var(--borde);border-radius:8px;padding:4px 12px;min-width:180px;">
                  <option value="">Seleccionar galpón...</option>
                </select>
              </div>
              <button class="btn-cerrar-lote" onclick="cerrarYEnviar()">
                <i data-lucide="check-circle" style="width:18px;height:18px;"></i> Cerrar y enviar a galpón
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- ── KPI Cards ── -->
      <div class="juntada-kpis">
        <div class="juntada-kpi">
          <div class="juntada-kpi-label">Total de hoy</div>
          <div class="juntada-kpi-valor" id="kpi-total-hoy">— kg</div>
        </div>
        <div class="juntada-kpi">
          <div class="juntada-kpi-label">Parcela actual hoy</div>
          <div class="juntada-kpi-valor" id="kpi-parcela-hoy">— kg</div>
        </div>
        <div class="juntada-kpi">
          <div class="juntada-kpi-label">Lote actual</div>
          <div class="juntada-kpi-valor" id="kpi-lote-actual">— kg</div>
        </div>
      </div>
      <div class="juntada-kpis" style="grid-template-columns:1fr 1fr 1fr;">
        <div class="juntada-kpi">
          <div class="juntada-kpi-label">Campaña actual</div>
          <div class="juntada-kpi-valor" id="kpi-campana">— kg</div>
        </div>
      </div>

      <div class="juntada-layout" id="juntada-layout">
      <div class="juntada-form" id="juntada-form-col">

        <!-- ── Parcela ── -->
        <div class="card-form">
          <div class="form-row">
            <label>Parcela</label>
            <select id="parcela" onchange="checkReady(); cargarKpisJuntada();" data-tooltip="Seleccioná el parcela que se está cosechando hoy">
              <option value="">Cargando parcelas...</option>
            </select>
          </div>
        </div>

        <!-- ── PASO 1: Cosechador ── -->
        <div class="card-form">
          <div class="section-label" style="margin-top:0;">Cosechador</div>
          <div class="cosechador-modos">
            <button id="btn-modo-lista" class="modo-btn active" onclick="setModo('lista')">
              <i data-lucide="list" style="width:14px;height:14px;"></i> Seleccionar
            </button>
            <button id="btn-modo-qr" class="modo-btn" onclick="setModo('qr')">
              <i data-lucide="scan-line" style="width:14px;height:14px;"></i> Escanear QR
            </button>
          </div>
          <div id="modo-lista">
            <select id="lista-juntadores" onchange="seleccionarJuntadorLista(this.value)">
              <option value="">— seleccionar cosechador —</option>
            </select>
          </div>
          <div id="modo-qr" style="display:none;">
            <div class="juntador-info" id="juntador-info">Escaneá el QR del cosechador</div>
            <button class="btn btn-scan" onclick="toggleCamera()" style="margin-top:8px;" data-tooltip="Escaneá el código QR del cosechador">
              <i data-lucide="scan-line"></i> Escanear QR
            </button>
            <div id="camera-container" class="hidden" style="margin-top:12px;">
              <video id="video" autoplay playsinline></video>
              <canvas id="canvas" class="hidden"></canvas>
            </div>
          </div>
          <div id="juntador-chip" class="juntador-chip" style="display:none;">
            <i data-lucide="user-check" style="width:16px;height:16px;flex-shrink:0;"></i>
            <strong id="juntador-chip-nombre"></strong>
            <button onclick="limpiarJuntador()" class="juntador-chip-clear" title="Cambiar cosechador">✕</button>
          </div>
        </div>

        <!-- ── PASO 2: Kilos ── -->
        <div class="card-form">
          <div class="section-label" style="margin-top:0;font-size:13px;letter-spacing:0.1em;color:#666;">KILOS COSECHADOS</div>
          <div class="kilos-input-wrap">
            <input type="text" inputmode="decimal" id="peso-manual"
