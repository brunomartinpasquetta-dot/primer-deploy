  // LOTE ACTIVO
  // ══════════════════════════════════════════════════════════════════
  var _loteActivo = null;

  function cargarLoteActivo() {
    fetch('/api/juntada/lotes').then(function(r){ return r.json(); }).then(function(data) {
      if (data.length > 0) {
        _loteActivo = data[0]; // El más reciente abierto
        mostrarLoteActivo();
      } else {
        _loteActivo = null;
        mostrarSinLote();
      }
    }).catch(function() { _loteActivo = null; mostrarSinLote(); });
  }

  function mostrarLoteActivo() {
    document.getElementById('lote-sin-activo').style.display = 'none';
    document.getElementById('lote-activo').style.display = '';
    document.getElementById('lote-codigo').textContent = _loteActivo.codigo_interno;
    document.getElementById('kpi-lote-actual').textContent =
      parseFloat(_loteActivo.kg_juntadas || 0).toLocaleString('es-AR', {maximumFractionDigits:1}) + ' kg';
    document.getElementById('hist-lote-badge').textContent = _loteActivo.codigo_interno;
    // Modo lote: mostrar grilla juntadores, ocultar formulario individual
    document.getElementById('juntada-form-col').style.display = 'none';
    document.getElementById('sec-juntadores').style.display = '';
    document.getElementById('juntada-layout').classList.add('lote-mode');
    document.getElementById('junt-lote-badge').textContent = _loteActivo.codigo_interno;
    document.getElementById('sec-destino').style.display = 'none';
    cargarRegistrosJuntLote();
  }

  function mostrarSinLote() {
    document.getElementById('lote-sin-activo').style.display = '';
    document.getElementById('lote-activo').style.display = 'none';
    document.getElementById('kpi-lote-actual').textContent = '— kg';
    document.getElementById('hist-lote-badge').textContent = '';
    // Modo legacy: mostrar formulario, ocultar grilla juntadores
    document.getElementById('juntada-form-col').style.display = '';
    document.getElementById('sec-juntadores').style.display = 'none';
    document.getElementById('juntada-layout').classList.remove('lote-mode');
  }

  function iniciarJuntada() {
    fetch('/api/juntada/crear-lote', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
      .then(function(r){ return r.json(); }).then(function(data) {
        if (data.ok) {
          mostrarMensaje('mensaje', 'success', 'Juntada iniciada: ' + data.codigo_interno);
          cargarLoteActivo();
        } else { mostrarMensaje('mensaje', 'error', data.error || 'Error'); }
      }).catch(function() { mostrarMensaje('mensaje', 'error', 'Error de conexión'); });
  }

  function cerrarYEnviar() {
    if (!_loteActivo) return;
    var deposito_id = parseInt(document.getElementById('sel-galpon').value);
    if (!deposito_id) { alert('Seleccioná un galpón'); return; }
    var kgLote = parseFloat(_loteActivo.kg_juntadas || 0);
    if (kgLote <= 0) { alert('El lote no tiene juntadas registradas'); return; }
    if (!confirm('¿Cerrar lote ' + _loteActivo.codigo_interno + ' y enviar a galpón?\n\nTotal: ' +
      kgLote.toLocaleString('es-AR', {maximumFractionDigits:1}) + ' kg')) return;
    fetch('/api/juntada/lote/' + _loteActivo.id + '/cerrar', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ deposito_id: deposito_id })
    }).then(function(r){ return r.json(); }).then(function(data) {
      if (data.ok) {
        mostrarMensaje('mensaje', 'success', 'Lote cerrado y enviado a galpón (' +
          parseFloat(data.kilos || 0).toLocaleString('es-AR', {maximumFractionDigits:1}) + ' kg)');
        _loteActivo = null;
        mostrarSinLote();
        cargarHistorial();
        cargarKpisJuntada();
      } else { mostrarMensaje('mensaje', 'error', data.error || 'Error'); }
    }).catch(function() { mostrarMensaje('mensaje', 'error', 'Error de conexión'); });
  }

  // Cargar depósitos para el selector de galpón
  fetch('/api/juntada/depositos-cosecha').then(function(r){ return r.json(); }).then(function(data) {
    var sel = document.getElementById('sel-galpon');
    sel.innerHTML = '<option value="">Seleccionar galpón...</option>';
    data.forEach(function(d) { sel.innerHTML += '<option value="' + d.id + '">' + d.nombre + '</option>'; });
  });

  // ══════════════════════════════════════════════════════════════════
  // JUNTADORES DEL LOTE (modo lote — patrón despalillado)
  // ══════════════════════════════════════════════════════════════════
  var _juntAgrupados = {};
  var _registrosJuntLote = [];

  function poblarSelectorJuntadores() {
    var sel = document.getElementById('sel-nuevo-juntador');
    sel.innerHTML = '<option value="">Seleccionar cosechador...</option>';
    _juntadoresData.forEach(function(j) {
      sel.innerHTML += '<option value="' + j.id + '">' + j.apellido + ', ' + j.nombre + '</option>';
    });
  }

  function cargarRegistrosJuntLote() {
    if (!_loteActivo) return;
    fetch('/api/juntada/lote/' + _loteActivo.id + '/registros')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        _registrosJuntLote = data;
        agruparJuntadoresLote(data);
        renderJuntadores();
      });
  }

  function agruparJuntadoresLote(registros) {
    _juntAgrupados = {};
    registros.forEach(function(r) {
      if (r.estado === 'anulada') return;
      var jid = r.juntador_id;
      if (!_juntAgrupados[jid]) {
        _juntAgrupados[jid] = { id: jid, nombre: r.cosechero, registros: [], totalKg: 0 };
      }
      _juntAgrupados[jid].registros.push(r);
      _juntAgrupados[jid].totalKg += parseFloat(r.kilos) || 0;
    });
    // Incluir también registros anulados en el detalle (pero no sumarlos)
    registros.forEach(function(r) {
      if (r.estado !== 'anulada') return;
      var jid = r.juntador_id;
      if (!_juntAgrupados[jid]) {
        _juntAgrupados[jid] = { id: jid, nombre: r.cosechero, registros: [], totalKg: 0 };
      }
      _juntAgrupados[jid].registros.push(r);
    });
  }

  function renderJuntadores() {
    var tbody = document.getElementById('tbody-juntadores-grid');
    var ids = Object.keys(_juntAgrupados);
    var totalKg = 0;
    var fmt = function(n) { return parseFloat(n||0).toLocaleString('es-AR',{minimumFractionDigits:0,maximumFractionDigits:1}); };
    var fmtF = function(iso) { if (!iso) return '—'; var d = new Date(iso); return String(d.getDate()).padStart(2,'0')+'/'+String(d.getMonth()+1).padStart(2,'0')+' '+String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0'); };

    if (!ids.length) {
      tbody.innerHTML = '<tr><td colspan="4" class="empty">Agregá cosechadores con + Cosechador</td></tr>';
      document.getElementById('junt-total').textContent = '—';
      document.getElementById('junt-contador').textContent = '';
      return;
    }

    var mono = "font-family:'JetBrains Mono',monospace;";
    var parcelaOpts = '<option value="">Parcela...</option>' + parcelasData.map(function(p) {
      return '<option value="' + p.id + '">' + p.nombre + '</option>';
    }).join('');
    var html = '';

    ids.forEach(function(jid) {
      var j = _juntAgrupados[jid];
      var cantActivas = j.registros.filter(function(r) { return r.estado !== 'anulada'; }).length;
      totalKg += j.totalKg;

      // Fila principal del cosechero
      html += '<tr>' +
        '<td style="font-size:13px;font-weight:600;">' + j.nombre + '</td>' +
        '<td style="text-align:center;' + mono + '">' + cantActivas + '</td>' +
        '<td style="text-align:right;' + mono + 'font-weight:700;color:var(--verde);">' + fmt(j.totalKg) + ' kg</td>' +
        '<td style="text-align:center;white-space:nowrap;">' +
          '<button class="btn-pesaje" onclick="toggleJuntadaForm(' + jid + ')">' +
            '<i data-lucide="plus" style="width:12px;height:12px;"></i> Juntada</button> ' +
          '<button class="btn-detalle" onclick="toggleDetalleJunt(' + jid + ')">' +
            '<i data-lucide="eye" style="width:12px;height:12px;"></i></button>' +
        '</td></tr>';

      // Fila inline para registrar juntada
      html += '<tr class="juntada-form-row" id="juntada-form-' + jid + '" style="display:none;">' +
        '<td colspan="4" style="background:var(--verde-suave);padding:8px 10px;">' +
          '<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">' +
            '<label style="font-size:11px;font-weight:600;color:var(--texto-secundario);">Parcela:</label>' +
            '<select id="juntada-parcela-' + jid + '" style="height:32px;font-size:12px;border:1.5px solid var(--borde);border-radius:6px;padding:2px 8px;min-width:120px;">' + parcelaOpts + '</select>' +
            '<label style="font-size:11px;font-weight:600;color:var(--texto-secundario);">Kg:</label>' +
            '<input type="number" inputmode="decimal" id="juntada-kg-' + jid + '" placeholder="0.00" min="0" step="any" ' +
              'style="height:32px;width:90px;font-size:14px;font-weight:700;border:1.5px solid var(--verde);border-radius:8px;padding:4px 10px;text-align:center;' + mono + '">' +
            '<button class="btn btn-primary" onclick="registrarJuntadaInline(' + jid + ')" style="height:32px;font-size:12px;padding:4px 14px;">Confirmar</button>' +
            '<button class="btn" onclick="toggleJuntadaForm(' + jid + ')" style="height:32px;font-size:12px;padding:4px 14px;">Cancelar</button>' +
          '</div>' +
        '</td></tr>';

      // Fila expandible con detalle
      html += '<tr class="desp-detalle-row" id="junt-detalle-' + jid + '" style="display:none;">' +
        '<td colspan="4" style="background:var(--fondo);padding:6px 10px;">';
      if (j.registros.length) {
        html += '<table style="width:100%;border-collapse:collapse;font-size:12px;">' +
          '<thead><tr>' +
          '<th style="text-align:left;padding:4px 6px;font-size:10px;color:var(--texto-suave);">Fecha</th>' +
          '<th style="text-align:left;padding:4px 6px;font-size:10px;color:var(--texto-suave);">Parcela</th>' +
          '<th style="text-align:right;padding:4px 6px;font-size:10px;color:var(--texto-suave);">Kg</th>' +
          '<th style="text-align:left;padding:4px 6px;font-size:10px;color:var(--texto-suave);">Usuario</th>' +
          '<th style="text-align:center;padding:4px 6px;font-size:10px;color:var(--texto-suave);">Acciones</th></tr></thead><tbody>';
        j.registros.forEach(function(r) {
          var anulada = r.estado === 'anulada';
          var acciones = anulada
            ? '<span class="badge-anulada">Anulada</span>'
            : '<button class="btn-icon" title="Editar" onclick="editarJuntadaLote(' + r.id + ', ' + parseFloat(r.kilos) + ')" style="padding:2px 4px;">' +
                '<i data-lucide="pencil" style="width:12px;height:12px;"></i></button>' +
              '<button class="btn-icon-danger" title="Anular" onclick="anularJuntadaLote(' + r.id + ')" style="padding:2px 4px;">' +
                '<i data-lucide="ban" style="width:12px;height:12px;"></i></button>';
          html += '<tr' + (anulada ? ' style="opacity:.5;text-decoration:line-through;"' : '') + '>' +
            '<td style="padding:4px 6px;">' + fmtF(r.fecha_hora) + '</td>' +
            '<td style="padding:4px 6px;font-size:11px;">' + (r.parcela || '—') + '</td>' +
            '<td style="text-align:right;padding:4px 6px;' + mono + 'font-weight:700;color:var(--verde);">' + fmt(r.kilos) + ' kg</td>' +
            '<td style="padding:4px 6px;font-size:11px;color:var(--texto-suave);">' + (r.usuario || '') + '</td>' +
            '<td style="text-align:center;padding:4px 6px;">' + acciones + '</td></tr>';
        });
        html += '</tbody></table>';
      } else {
        html += '<div style="text-align:center;padding:8px;color:var(--texto-suave);font-size:12px;">Sin juntadas aún</div>';
      }
      html += '</td></tr>';
    });

    tbody.innerHTML = html;
    document.getElementById('junt-total').textContent = fmt(totalKg) + ' kg';
    document.getElementById('junt-contador').textContent = '(' + ids.length + ' cosecheros — ' + fmt(totalKg) + ' kg)';
    lucide.createIcons();
  }

  function toggleJuntadaForm(jid) {
    var form = document.getElementById('juntada-form-' + jid);
    var isOpen = form.style.display !== 'none';
    document.querySelectorAll('.juntada-form-row').forEach(function(f) { f.style.display = 'none'; });
    if (!isOpen) {
      form.style.display = '';
      // Recordar última parcela usada
      var selP = document.getElementById('juntada-parcela-' + jid);
      var lastParcela = localStorage.getItem('ultimo_parcela');
      if (lastParcela && selP) selP.value = lastParcela;
      document.getElementById('juntada-kg-' + jid).focus();
    }
  }

  function toggleDetalleJunt(jid) {
    var row = document.getElementById('junt-detalle-' + jid);
    row.style.display = row.style.display === 'none' ? '' : 'none';
  }

  function toggleAddJuntador() {
    document.getElementById('add-juntador-form').classList.toggle('open');
  }

  function agregarJuntadorAlLote() {
    var sel = document.getElementById('sel-nuevo-juntador');
    var jid = parseInt(sel.value);
    if (!jid) return;
    if (_juntAgrupados[jid]) { alert('Este cosechador ya está en el lote'); sel.value = ''; return; }
    var nombre = sel.options[sel.selectedIndex].text;
    _juntAgrupados[jid] = { id: jid, nombre: nombre, registros: [], totalKg: 0 };
    renderJuntadores();
    toggleAddJuntador();
    sel.value = '';
    setTimeout(function() { toggleJuntadaForm(jid); }, 100);
  }

  function registrarJuntadaInline(jid) {
    if (!_loteActivo) return;
    var parcela_id = document.getElementById('juntada-parcela-' + jid).value;
    var kilosInput = document.getElementById('juntada-kg-' + jid);
    var kilos = parseFloat(kilosInput.value);
    if (!parcela_id) { mostrarMensaje('mensaje', 'error', 'Seleccioná una parcela'); return; }
    if (!kilos || kilos <= 0) { mostrarMensaje('mensaje', 'error', 'Ingresá los kilos'); return; }

    // Guardar parcela como última usada
    localStorage.setItem('ultimo_parcela', parcela_id);

    fetch('/api/juntada/lote/' + _loteActivo.id + '/registrar', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ juntador_id: jid, parcela_id: parseInt(parcela_id), kilos: kilos })
    }).then(function(r) { return r.json(); }).then(function(data) {
      if (data.ok) {
        kilosInput.value = '';
        toggleJuntadaForm(jid);
        mostrarMensaje('mensaje', 'success', '✓ Juntada registrada');
        refreshJuntLote();
      } else {
        mostrarMensaje('mensaje', 'error', data.error || 'Error');
      }
    }).catch(function() { mostrarMensaje('mensaje', 'error', 'Error de conexión'); });
  }

  function editarJuntadaLote(id, kilosActuales) {
    var fmt = function(n) { return parseFloat(n||0).toLocaleString('es-AR',{maximumFractionDigits:1}); };
    var newKilos = prompt('Nuevo peso en kg (actual: ' + fmt(kilosActuales) + ' kg):');
    if (newKilos === null) return;
    newKilos = parseFloat(newKilos);
    if (!newKilos || newKilos <= 0) { alert('Kilos debe ser mayor a 0'); return; }
    var motivo = prompt('Motivo de la edición:');
    if (!motivo) { alert('El motivo es obligatorio'); return; }
    fetch('/api/juntada/lote-registro/' + id, {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ kilos: newKilos, motivo: motivo })
    }).then(function(r) { return r.json(); }).then(function(data) {
      if (data.ok) { refreshJuntLote(); }
      else { alert(data.error || 'Error'); }
    }).catch(function() { alert('Error de conexión'); });
  }

  function anularJuntadaLote(id) {
    var motivo = prompt('Motivo de anulación:');
    if (!motivo) return;
    if (!confirm('¿Anular juntada #' + id + '?')) return;
    fetch('/api/juntada/lote-registro/' + id + '/anular', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ motivo: motivo })
    }).then(function(r) { return r.json(); }).then(function(data) {
      if (data.ok) { mostrarMensaje('mensaje', 'success', 'Juntada #' + id + ' anulada'); refreshJuntLote(); }
      else { mostrarMensaje('mensaje', 'error', data.error || 'Error'); }
    }).catch(function() { mostrarMensaje('mensaje', 'error', 'Error de conexión'); });
  }

  function refreshJuntLote() {
    cargarLoteActivo();
    cargarHistorial();
    cargarKpisJuntada();
  }

  // Override registrar para usar lote cuando hay lote activo
  var _registrarOriginal = registrar;
  registrar = function() {
    if (!_loteActivo) { _registrarOriginal(); return; }
    // Modo lote: registrar directamente al lote sin destinos
    var parcela_id = document.getElementById('parcela').value;
    var kilos = pesoActual || _parseEl('peso-manual');
    if (!parcela_id || !juntadorId || !kilos) {
      mostrarMensaje('mensaje', 'error', 'Completá parcela, cosechador y peso'); return;
    }
    var btn = document.getElementById('btn-registrar');
    setLoading(btn, true);
    fetch('/api/juntada/lote/' + _loteActivo.id + '/registrar', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ juntador_id: juntadorId, parcela_id: parseInt(parcela_id), kilos: kilos })
    }).then(function(r){ return r.json(); }).then(function(data) {
      setLoading(btn, false);
      if (data.ok) {
        mostrarMensaje('mensaje', 'success', '✓ Cosecha registrada en lote');
        resetFormulario();
        cargarHistorial();
        cargarLoteActivo();
      } else { mostrarMensaje('mensaje', 'error', data.error || 'Error'); }
    }).catch(function() { setLoading(btn, false); mostrarMensaje('mensaje', 'error', 'Error de conexión'); });
  };

  // Override checkReady para no requerir destino cuando hay lote activo
  var _checkReadyOriginal = checkReady;
  checkReady = function() {
    if (_loteActivo) {
      var kilos = pesoActual || 0;
      var parcelaOk = !!document.getElementById('parcela').value;
      var juntadorOk = !!juntadorId;
      var kilosOk = kilos > 0;
      document.getElementById('btn-registrar').disabled = !(parcelaOk && juntadorOk && kilosOk);
      document.getElementById('sec-destino').style.display = 'none';
    } else {
      _checkReadyOriginal();
    }
  };

  cargarHistorial();
  cargarLoteActivo();
  cargarTemporadaActiva();
</script>


</body>
