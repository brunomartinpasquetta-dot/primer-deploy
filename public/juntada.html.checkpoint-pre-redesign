<script src="js/jsqr.min.js"></script>
<script src="https://unpkg.com/lucide@latest"></script>
<script>
  lucide.createIcons();
  document.getElementById('topbar-date').textContent =
    new Date().toLocaleDateString('es-AR', { weekday:'long', day:'numeric', month:'long' });

  var juntadorId = null, pesoActual = null, scanning = false, stream = null;
  var modoActual = 'lista';
  var tipoDestinoPrincipal = null, tipoDestinoSecundario = null;
  var parcelasData = [], depositos = [];
  var _ultimaJuntada = null;

  // ── Cargar parcelas ───────────────────────────────────────────────
  function cargarParcelas() {
    fetch('/api/temporadas/activa').then(r => r.json()).then(function(t) {
      var sel = document.getElementById('parcela');
      if (!t) { sel.innerHTML = '<option value="">No hay campaña activa</option>'; parcelasData = []; return; }
      fetch('/api/parcelas?temporada_id=' + t.id).then(r => r.json()).then(function(parcelas) {
        parcelasData = parcelas;
        if (!parcelas.length) { sel.innerHTML = '<option value="">Sin parcelas en esta campaña</option>'; return; }
        sel.innerHTML = '<option value="">Seleccionar parcela...</option>';
        parcelas.forEach(function(l) {
          sel.innerHTML += '<option value="' + l.id + '">' + l.nombre + '</option>';
        });
        recordarSeleccion('parcela', 'ultimo_parcela');
      });
    });
  }
  cargarParcelas();
  window.addEventListener('campanaChange', cargarParcelas);

  // ── Cargar cosechadores en lista ───────────────────────────────
  var _juntadoresData = [];
  fetch('/api/juntadores').then(r => r.json()).then(function(data) {
    _juntadoresData = data;
    var sel = document.getElementById('lista-juntadores');
    if (!data.length) { sel.innerHTML = '<option value="">Sin cosechadores registrados</option>'; return; }
    sel.innerHTML = '<option value="">— seleccionar cosechador —</option>' +
      data.map(function(j) {
        return '<option value="' + j.id + '" data-nombre="' + j.apellido + ', ' + j.nombre + '">' +
               j.apellido + ', ' + j.nombre + '</option>';
      }).join('');
    poblarSelectorJuntadores();
  });

  // ── Cargar depósitos ───────────────────────────────────────────
  fetch('/api/depositos?tipo_stock=mercaderia').then(r => r.json()).then(function(deps) {
    depositos = deps;
  });

  // ── WebSocket balanza ──────────────────────────────────────────
  var ws = new WebSocket('ws://' + location.host);
  ws.onmessage = function(e) {
    var data = JSON.parse(e.data);
    if (data.tipo === 'peso') {
      document.getElementById('peso-manual').value = data.valor;
      onKilosChange();
    }
  };

  // ── Modos cosechador ───────────────────────────────────────────
  function setModo(modo) {
    modoActual = modo;
    document.getElementById('btn-modo-lista').classList.toggle('active', modo === 'lista');
    document.getElementById('btn-modo-qr').classList.toggle('active', modo === 'qr');
    document.getElementById('modo-lista').style.display = modo === 'lista' ? '' : 'none';
    document.getElementById('modo-qr').style.display = modo === 'qr' ? '' : 'none';
    limpiarJuntador();
  }

  function seleccionarJuntadorLista(id) {
    if (!id) return;
    var sel = document.getElementById('lista-juntadores');
    var opt = sel.options[sel.selectedIndex];
    juntadorId = parseInt(id);
    mostrarChip(opt.dataset.nombre || opt.text);
    checkReady();
  }

  function mostrarChip(nombre) {
    document.getElementById('juntador-chip-nombre').textContent = nombre;
    document.getElementById('juntador-chip').style.display = 'flex';
    lucide.createIcons();
  }

  function limpiarJuntador() {
    juntadorId = null;
    document.getElementById('juntador-chip').style.display = 'none';
    if (modoActual === 'lista') document.getElementById('lista-juntadores').value = '';
    else {
      document.getElementById('juntador-info').textContent = 'Escaneá el QR del cosechador';
      document.getElementById('juntador-info').style.cssText = '';
    }
    checkReady();
  }

  // ── QR ─────────────────────────────────────────────────────────
  function toggleCamera() { if (scanning) stopCamera(); else startCamera(); }
  function startCamera() {
    scanning = true;
    document.getElementById('camera-container').classList.remove('hidden');
    navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } }).then(function(s) {
      stream = s; document.getElementById('video').srcObject = s; requestAnimationFrame(scanQR);
    });
  }
  function stopCamera() {
    scanning = false;
    if (stream) stream.getTracks().forEach(function(t) { t.stop(); });
    document.getElementById('camera-container').classList.add('hidden');
  }
  function scanQR() {
    if (!scanning) return;
    var video = document.getElementById('video'), canvas = document.getElementById('canvas');
    if (video.readyState === video.HAVE_ENOUGH_DATA) {
      canvas.width = video.videoWidth; canvas.height = video.videoHeight;
      var ctx = canvas.getContext('2d'); ctx.drawImage(video, 0, 0);
      var code = jsQR(ctx.getImageData(0, 0, canvas.width, canvas.height).data, canvas.width, canvas.height);
      if (code) { stopCamera(); buscarJuntador(code.data); return; }
    }
    requestAnimationFrame(scanQR);
  }
  function buscarJuntador(codigo) {
    fetch('/api/juntadores/qr/' + codigo).then(r => r.json()).then(function(j) {
      var el = document.getElementById('juntador-info');
      if (j.error) {
        el.textContent = 'QR no encontrado';
        el.style.cssText = 'background:#FEE2E2;color:#991B1B;border-color:#FECACA;';
      } else {
        juntadorId = j.id;
        mostrarChip(j.apellido + ', ' + j.nombre);
        checkReady();
      }
    });
  }

  // ── Kilos ──────────────────────────────────────────────────────
  function onKilosChange() {
    var val = _parseEl('peso-manual');
    pesoActual = val > 0 ? val : null;
    var sec = document.getElementById('sec-destino');
    sec.style.display = val > 0 ? '' : 'none';
    if (val > 0) {
      document.getElementById('kg-para-distribuir').textContent =
        val.toLocaleString('es-AR', {maximumFractionDigits:2}) + ' kg para distribuir';
    }
    // Reset destino when kilos change
    tipoDestinoPrincipal = null;
    tipoDestinoSecundario = null;
    document.querySelectorAll('.destino-tipo-btn').forEach(function(b) { b.classList.remove('active'); });
    document.getElementById('destino-form-principal').innerHTML = '';
    document.getElementById('destino-form-secundario').innerHTML = '';
    document.getElementById('sec-restantes').style.display = 'none';
    document.getElementById('destino-grid-secundario').innerHTML = '';
    checkReady();
  }

  // ── Destino ────────────────────────────────────────────────────
  function renderDestinoForm(tipo, kilos, prefix) {
    var k = (parseFloat(kilos) || 0).toFixed(3);
    var depOpts = depositos.map(function(d) {
      return '<option value="' + d.id + '" data-tipo="' + (d.tipo || '') + '">' + d.nombre + '</option>';
    }).join('');

    if (tipo === 'deposito') {
      return '<div class="destino-form-inner">' +
        '<div class="form-row"><label>Kilos a depositar</label>' +
        '<input type="number" id="' + prefix + '-kilos-deposito" value="' + k + '" step="0.001" min="0" ' +
        'style="-moz-appearance:textfield;appearance:textfield;" oninput="actualizarRestantes()"></div>' +
        '<div class="form-row"><label>Depósito</label>' +
        '<select id="' + prefix + '-select-deposito" onchange="checkDepositoCamaraFria(this)">' +
        '<option value="">Seleccionar depósito...</option>' + depOpts + '</select></div>' +
        '<div id="' + prefix + '-aviso-camara" style="display:none;margin-top:8px;padding:8px 12px;background:var(--sem-amarillo-bg);border-left:3px solid var(--sem-amarillo);border-radius:6px;font-size:13px;color:var(--sem-amarillo);">' +
        '⚠️ <strong>Cámara fría:</strong> el stock se registrará al completar el despalillado, no ahora.' +
        '</div></div>';
    }
    if (tipo === 'descarte') {
      return '<div class="destino-form-inner">' +
        '<div class="form-row"><label>Kilos a descartar</label>' +
        '<input type="number" id="' + prefix + '-kilos-descarte" value="' + k + '" step="0.001" min="0" ' +
        'style="-moz-appearance:textfield;appearance:textfield;" oninput="actualizarRestantes()"></div>' +
        '<div class="form-row"><label>Motivo</label>' +
        '<select id="' + prefix + '-motivo-descarte">' +
        '<option value="calidad">Baja calidad</option><option value="daño">Daño físico</option>' +
        '<option value="enfermedad">Enfermedad/plaga</option><option value="otro">Otro</option>' +
        '</select></div></div>';
    }
    return '';
  }

  function renderDestinoGrid(prefix) {
    var items = [
      {tipo:'deposito', icon:'📦', label:'Depósito'},
      {tipo:'descarte', icon:'🗑️', label:'Descarte'}
    ];
    return items.map(function(it) {
      return '<button class="destino-tipo-btn" onclick="seleccionarDestino(\'' + it.tipo + '\',this,false)">' +
             '<span class="destino-btn-icon">' + it.icon + '</span><span>' + it.label + '</span></button>';
    }).join('');
  }

  function seleccionarDestino(tipo, btn, esPrincipal) {
    var kilosTotal = pesoActual || 0;
    var grid = esPrincipal ? '#destino-grid-principal' : '#destino-grid-secundario';
    document.querySelectorAll(grid + ' .destino-tipo-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');

    if (esPrincipal) {
      tipoDestinoPrincipal = tipo;
      tipoDestinoSecundario = null;
      document.getElementById('destino-form-principal').innerHTML = renderDestinoForm(tipo, kilosTotal, 'p');
      document.getElementById('sec-restantes').style.display = 'none';
      document.getElementById('destino-form-secundario').innerHTML = '';
      document.getElementById('destino-grid-secundario').innerHTML = '';
      lucide.createIcons();
    } else {
      tipoDestinoSecundario = tipo;
      var restantes = kilosTotal - getKilosAsignados('p');
      document.getElementById('destino-form-secundario').innerHTML = renderDestinoForm(tipo, Math.max(0, restantes), 's');
      lucide.createIcons();
    }
    setTimeout(actualizarRestantes, 50);
    checkReady();
  }

  function checkDepositoCamaraFria(sel) {
    var opt = sel.options[sel.selectedIndex];
    var tipo = opt ? opt.getAttribute('data-tipo') : '';
    // Detectar el prefix por el id del select (p-select-deposito o s-select-deposito)
    var prefix = sel.id.startsWith('p') ? 'p' : 's';
    var aviso = document.getElementById(prefix + '-aviso-camara');
    if (aviso) aviso.style.display = (tipo === 'camara_fria') ? 'block' : 'none';
  }

  function getKilosAsignados(prefix) {
    var suma = 0;
    ['kilos-deposito', 'kilos-venta', 'kilos-descarte'].forEach(function(campo) {
      var el = document.getElementById(prefix + '-' + campo);
      if (el) suma += parseFloat(el.value) || 0;
    });
    return suma;
  }

  function actualizarRestantes() {
    var kilosTotal = pesoActual || 0;
    if (kilosTotal <= 0 || !tipoDestinoPrincipal) { checkReady(); return; }
    var asignadoPrincipal = getKilosAsignados('p');
    var asignadoSecundario = getKilosAsignados('s');
    var totalAsignado = asignadoPrincipal + asignadoSecundario;
    var restantes = kilosTotal - totalAsignado;
    var sec = document.getElementById('sec-restantes');

    if (asignadoPrincipal <= 0) { sec.style.display = 'none'; checkReady(); return; }

    if (restantes > 0.01) {
      sec.style.display = '';
      document.getElementById('kilos-restantes-msg').textContent =
        '⚠ Quedan ' + restantes.toFixed(2) + ' kg sin destino — ¿qué hacemos con ellos?';
      var grid = document.getElementById('destino-grid-secundario');
      if (!grid.innerHTML.trim()) grid.innerHTML = renderDestinoGrid('s');
    } else if (restantes < -0.01) {
      sec.style.display = '';
      document.getElementById('kilos-restantes-msg').textContent =
        '⚠ Excedido en ' + Math.abs(restantes).toFixed(2) + ' kg — reducí algún destino';
      // Don't show secondary selector when exceeded
      document.getElementById('destino-grid-secundario').innerHTML = '';
    } else {
      sec.style.display = 'none';
    }
    checkReady();
  }

  // ── Validación y registro ──────────────────────────────────────
  function checkReady() {
    var kilos = pesoActual || 0;
    var parcelaOk = !!document.getElementById('parcela').value;
    var juntadorOk = !!juntadorId;
    var kilosOk = kilos > 0;
    var destinoOk = false;

    if (tipoDestinoPrincipal) {
      var totalAsignado = getKilosAsignados('p') + getKilosAsignados('s');
      destinoOk = Math.abs(totalAsignado - kilos) < 0.01 && totalAsignado > 0;
    }

    document.getElementById('btn-registrar').disabled = !(parcelaOk && juntadorOk && kilosOk && destinoOk);
  }

  function _recopilarDestinos() {
    var destinos = [];

    function addFromPrefix(prefix, tipo) {
      if (!tipo) return null;
      var tipos = [tipo];
      for (var i = 0; i < tipos.length; i++) {
        var t = tipos[i];
        var kilosEl = document.getElementById(prefix + '-kilos-' + t);
        var kilos = parseFloat(kilosEl ? kilosEl.value : 0) || 0;
        if (kilos <= 0) continue;
        if (t === 'deposito') {
          var dep = document.getElementById(prefix + '-select-deposito');
          if (!dep || !dep.value) return { error: 'Seleccioná un depósito para los kilos en depósito' };
          destinos.push({ tipo: 'deposito', kilos: kilos, deposito_id: parseInt(dep.value) });
        } else if (t === 'descarte') {
          destinos.push({
            tipo: 'descarte', kilos: kilos,
            motivo: document.getElementById(prefix + '-motivo-descarte').value
          });
        }
      }
      return null;
    }

    var err = addFromPrefix('p', tipoDestinoPrincipal);
    if (err) return err;
    err = addFromPrefix('s', tipoDestinoSecundario);
    if (err) return err;
    return destinos;
  }

  function registrar() {
    var parcela_id = document.getElementById('parcela').value;
    var kilos = pesoActual || _parseEl('peso-manual');
    if (!parcela_id || !juntadorId || !kilos) {
      mostrarMensaje('mensaje', 'error', 'Completá parcela, cosechador y peso'); return;
    }
    if (!tipoDestinoPrincipal) {
      mostrarMensaje('mensaje', 'error', 'Seleccioná un destino para la cosecha'); return;
    }
    var destinos = _recopilarDestinos();
    if (destinos && destinos.error) {
      mostrarMensaje('mensaje', 'error', destinos.error); return;
    }
    var suma = destinos.reduce(function(a, d) { return a + d.kilos; }, 0);
    if (Math.abs(suma - kilos) > 0.01) {
      mostrarMensaje('mensaje', 'error', 'Los kilos asignados (' + suma.toFixed(2) + ') no coinciden con el total (' + kilos + ' kg)'); return;
    }
    _enviarRegistro(parcela_id, kilos, destinos);
  }

  function _enviarRegistro(parcela_id, kilos, destinos) {
    var btn = document.getElementById('btn-registrar');
    setLoading(btn, true);
    fetch('/api/juntada', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ parcela_id: parseInt(parcela_id), juntador_id: juntadorId, kilos: kilos, destinos: destinos })
    }).then(function(r) { return r.json(); }).then(function(data) {
      setLoading(btn, false);
      if (data.ok) {
        mostrarMensaje('mensaje', 'success', '✓ Cosecha registrada correctamente');
        resetFormulario();
        cargarHistorial();
      } else {
        mostrarMensaje('mensaje', 'error', data.error || 'Error al guardar');
      }
    }).catch(function() {
      setLoading(btn, false);
      mostrarMensaje('mensaje', 'error', 'Error de conexión');
    });
  }

  function resetFormulario() {
    juntadorId = null;
    pesoActual = null;
    tipoDestinoPrincipal = null;
    tipoDestinoSecundario = null;
    document.getElementById('juntador-chip').style.display = 'none';
    document.getElementById('lista-juntadores').value = '';
    document.getElementById('juntador-info').textContent = 'Escaneá el QR del cosechador';
    document.getElementById('juntador-info').style.cssText = '';
    document.getElementById('peso-manual').value = '';
    document.getElementById('sec-destino').style.display = 'none';
    document.getElementById('destino-form-principal').innerHTML = '';
    document.getElementById('destino-form-secundario').innerHTML = '';
    document.getElementById('sec-restantes').style.display = 'none';
    document.getElementById('destino-grid-secundario').innerHTML = '';
    document.querySelectorAll('.destino-tipo-btn').forEach(function(b) { b.classList.remove('active'); });
    checkReady();
    lucide.createIcons();
  }

  // Devuelve {hoy, manana} en formato YYYY-MM-DD (fechas locales)
  function _fechasHoy() {
    var _d = new Date();
    var hoy = _d.getFullYear() + '-' + String(_d.getMonth()+1).padStart(2,'0') + '-' + String(_d.getDate()).padStart(2,'0');
    var _m = new Date(_d.getFullYear(), _d.getMonth(), _d.getDate() + 1);
    var manana = _m.getFullYear() + '-' + String(_m.getMonth()+1).padStart(2,'0') + '-' + String(_m.getDate()).padStart(2,'0');
    return { hoy: hoy, manana: manana, d: _d };
  }

  // Filtra registros cuya fecha local sea hoy
  function _esHoy(m, _d) {
    var f = new Date(m.fecha);
    return f.getFullYear() === _d.getFullYear() && f.getMonth() === _d.getMonth() && f.getDate() === _d.getDate();
  }

  var _juntadaData = [];
  var _juntadaCols = [
    {label:'Cosechero',campo:'cosechero'},
    {label:'Parcela',campo:'parcela'},
    {label:'Depósito',campo:'deposito'},
    {label:'Tipo',campo:'tipo'}
  ];

  function _renderHoyRow(m) {
    var esIngreso  = m.tipo === 'ingreso';
    var esPendiente = m.tipo === 'pendiente_despalillado';
    var esAnulada = !!m.anulada;
    var bg = esPendiente ? 'background:#fffbeb;' : esIngreso ? 'background:#f0faf0;' : 'background:#fff5f5;';
    var colorKg = esPendiente ? 'color:#b45309;font-weight:700;' : esIngreso ? 'color:#2d6a4f;font-weight:700;' : 'color:#c0392b;font-weight:700;';
    var signo = esIngreso ? '+' : esPendiente ? '~' : '-';
    var tipoBadge = esPendiente
      ? '<span class="badge" style="background:#fef3c7;color:#92400e;">Pendiente</span>'
      : esIngreso
        ? '<span class="badge" style="background:var(--sem-verde-bg);color:var(--sem-verde);">Ingreso</span>'
        : '<span class="badge" style="background:var(--sem-rojo-bg);color:var(--sem-rojo);">Egreso</span>';
    var _chip = function(id) { if (!id && id !== 0) return ''; return ' <span style="font-family:\'JetBrains Mono\',monospace;font-size:10px;background:var(--fondo-dark);border:1px solid var(--borde);border-radius:4px;padding:1px 4px;opacity:.75;">#' + id + '</span>'; };
    var _jidBadge = function(jid) { if (!jid) return '—'; return '<span style="font-family:\'JetBrains Mono\',monospace;font-size:11px;background:var(--fondo-dark);border:1px solid var(--borde);border-radius:4px;padding:1px 5px;">#' + jid + '</span>'; };
    var _fmt = function(n) { return parseFloat(n || 0).toLocaleString('es-AR', {minimumFractionDigits:0, maximumFractionDigits:1}); };
    var _fmtFecha = function(iso) { if (!iso) return '—'; var d = new Date(iso); var dd=String(d.getDate()).padStart(2,'0'); var mm=String(d.getMonth()+1).padStart(2,'0'); var yy=d.getFullYear(); var hh=String(d.getHours()).padStart(2,'0'); var mn=String(d.getMinutes()).padStart(2,'0'); return dd+'/'+mm+'/'+yy+' '+hh+':'+mn; };

    var acciones = esAnulada
      ? '<span class="badge-anulada">Anulada</span>'
      : '<button class="btn-icon" title="Editar" onclick="editarJuntada(' + m.juntada_id + ')"><i data-lucide="pencil"></i></button>' +
        '<button class="btn-icon-danger" title="Anular" onclick="anularJuntada(' + m.juntada_id + ')"><i data-lucide="ban"></i></button>';

    var trClass = esAnulada ? ' class="row-anulada"' : '';
    return '<tr' + trClass + ' style="' + (esAnulada ? '' : bg) + '">' +
      '<td style="text-align:center;">' + _jidBadge(m.juntada_id) + '</td>' +
      '<td style="font-size:13px;">' + (m.cosechero || '—') + _chip(m.juntador_id) + '</td>' +
      '<td style="font-size:12px;white-space:nowrap;">' + _fmtFecha(m.fecha) + '</td>' +
      '<td>' + tipoBadge + '</td>' +
      '<td style="text-align:right;font-family:\'JetBrains Mono\',monospace;' + colorKg + '">' + signo + _fmt(m.kilos) + ' kg</td>' +
      '<td style="font-size:12px;">' + (m.parcela || '—') + '</td>' +
      '<td style="font-size:12px;font-family:\'JetBrains Mono\',monospace;">' + (m.lote_codigo || '—') + '</td>' +
      '<td style="font-size:12px;">' + (m.deposito || m.destino_venta || '—') + '</td>' +
      '<td style="font-size:12px;">' + (m.usuario || '—') + _chip(m.usuario_id) + '</td>' +
      '<td style="text-align:center;white-space:nowrap;">' + acciones + '</td>' +
    '</tr>';
  }

  function _renderHoyGrid(tbodyId, data) {
    var tbody = document.getElementById(tbodyId);
    if (!tbody) return;
    if (!data || !data.length) {
      tbody.innerHTML = '<tr><td colspan="10" class="empty">Sin movimientos</td></tr>';
      return;
    }
    tbody.innerHTML = data.map(_renderHoyRow).join('');
    lucide.createIcons();
  }

  function filtrarJuntada() {
    var q = (document.getElementById('juntada-buscar').value || '').trim();
    if (!q) { _renderHoyGrid('tbody-hist-hoy', _juntadaData); return; }
    var filtrado;
    if (typeof matchFiltro === 'function') {
      filtrado = _juntadaData.filter(function(m) { return matchFiltro(m, q, _juntadaCols); });
    } else {
      var ql = q.toLowerCase();
      filtrado = _juntadaData.filter(function(m) {
        return _juntadaCols.some(function(col) {
          return (m[col.campo] || '').toString().toLowerCase().indexOf(ql) >= 0;
        });
      });
    }
    _renderHoyGrid('tbody-hist-hoy', filtrado);
  }

  function limpiarFiltrosJuntada() {
    document.getElementById('juntada-buscar').value = '';
    _renderHoyGrid('tbody-hist-hoy', _juntadaData);
  }

  function cargarHistorial() {
    var f = _fechasHoy();
    // destinos-hoy devuelve TODOS los tramos del día: fresco (ya en stock) y pendientes (cámara)
    fetch('/api/juntada/destinos-hoy')
      .then(function(r){ return r.json(); })
      .then(function(destinos) {
        // Mapear cada JuntadaDestino a formato compatible con movimientos-grid
        var data = destinos.map(function(d) {
          return {
            juntada_id:  d.juntada_id,
            cosechero:   d.cosechero,
            fecha:       d.fecha,
            tipo:        d.stock_pendiente ? 'pendiente_despalillado' : 'ingreso',
            kilos:       d.kilos,
            parcela: d.parcela,
            lote_codigo: d.lote_codigo || null,
            deposito:    d.deposito,
            parcela_id:  d.parcela_id,
            juntador_id: d.juntador_id,
            usuario:     d.usuario,
            usuario_id:  d.usuario_id,
            anulada:     d.anulada || false
          };
        });
        var totalKg = data.reduce(function(s, m) {
          return s + (m.tipo === 'ingreso' ? parseFloat(m.kilos || 0) : 0);
        }, 0);
        document.getElementById('hist-contador').textContent = data.length
          ? '(' + data.length + ' mov. — ' + totalKg.toLocaleString('es-AR', {maximumFractionDigits:2}) + ' kg ingresados)'
          : '';
        document.getElementById('hist-total').textContent = totalKg > 0
          ? totalKg.toLocaleString('es-AR', {minimumFractionDigits:0, maximumFractionDigits:2}) + ' kg'
          : '—';
        _juntadaData = data;
        poblarDatalist('juntada-opciones', data, _juntadaCols);
        filtrarJuntada();
        guardarUltimaJuntada(data);
        cargarKpisJuntada();
      })
      .catch(function() {
        document.getElementById('tbody-hist-hoy').innerHTML =
          '<tr><td colspan="9" class="empty">Error al cargar</td></tr>';
      });
  }

  function cargarKpisJuntada() {
    var f = _fechasHoy();
    var parcelaId = document.getElementById('parcela').value;

    fetch('/api/stock-mercaderia/historial?desde=' + f.hoy + '&hasta=' + f.manana)
      .then(function(r){ return r.json(); }).then(function(todos) {
        var data = todos.filter(function(m){ return _esHoy(m, f.d); });
        var total = data.filter(function(m){ return m.tipo === 'ingreso'; })
                        .reduce(function(s, m){ return s + parseFloat(m.kilos || 0); }, 0);
        document.getElementById('kpi-total-hoy').textContent =
          total.toLocaleString('es-AR', {maximumFractionDigits:1}) + ' kg';
      });

    if (parcelaId) {
      fetch('/api/stock-mercaderia/historial?desde=' + f.hoy + '&hasta=' + f.manana + '&parcela_id=' + parcelaId)
        .then(function(r){ return r.json(); }).then(function(todos) {
          var data = todos.filter(function(m){ return _esHoy(m, f.d); });
          var total = data.filter(function(m){ return m.tipo === 'ingreso'; })
                          .reduce(function(s, m){ return s + parseFloat(m.kilos || 0); }, 0);
          document.getElementById('kpi-parcela-hoy').textContent =
            total.toLocaleString('es-AR', {maximumFractionDigits:1}) + ' kg';
        });
    } else {
      document.getElementById('kpi-parcela-hoy').textContent = '— kg';
    }

    fetch('/api/stock-mercaderia/kpis')
      .then(function(r){ return r.json(); }).then(function(data) {
        document.getElementById('kpi-campana').textContent =
          parseFloat(data.kg_cosechados || 0).toLocaleString('es-AR', {maximumFractionDigits:1}) + ' kg';
      });
  }

  function guardarUltimaJuntada(data) {
    var ingresos = data.filter(function(m){ return m.tipo === 'ingreso' && m.cosechero; });
    if (ingresos.length > 0) {
      _ultimaJuntada = ingresos[0];
      document.getElementById('btn-repetir').style.display = '';
    }
  }

  function repetirUltimaJuntada() {
    if (!_ultimaJuntada) return;
    if (_ultimaJuntada.parcela_id) {
      var selParcela = document.getElementById('parcela');
      selParcela.value = _ultimaJuntada.parcela_id;
      selParcela.dispatchEvent(new Event('change'));
    }
    if (_ultimaJuntada.juntador_id) {
      juntadorId = _ultimaJuntada.juntador_id;
      mostrarChip(_ultimaJuntada.cosechero);
      var selJunt = document.getElementById('lista-juntadores');
      if (selJunt) selJunt.value = _ultimaJuntada.juntador_id;
    }
    document.getElementById('peso-manual').value = '';
    pesoActual = null;
    document.getElementById('sec-destino').style.display = 'none';
    checkReady();
  }

  // ── TABS: HISTORIAL / TOTALES ────────────────────────────────────
  var _historialData = [];

  function mostrarTab(tab) {
    var sec = document.getElementById('sec-hist-totales');
    sec.style.display = '';
    document.getElementById('tab-historial').classList.toggle('active', tab === 'historial');
    document.getElementById('tab-totales').classList.toggle('active', tab === 'totales');
    document.getElementById('tc-historial').classList.toggle('active', tab === 'historial');
    document.getElementById('tc-totales').classList.toggle('active', tab === 'totales');
    if (tab === 'historial') cargarHistorialInline();
    else cargarTotalesJuntador();
