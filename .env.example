# ══════════════════════════════════════════════════════════════
# CosechaApp — Variables de entorno
# Copiar este archivo a .env y completar con valores reales.
# NUNCA commitear .env con valores reales al repositorio.
# ══════════════════════════════════════════════════════════════

# ── Base de datos SQL Server ─────────────────────────────────
# Host del servidor SQL (localhost si es docker local, nombre del servicio si
# es docker-compose, IP del VPS si es externo)
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
# IMPORTANTE: usar una password fuerte en producción (mín. 16 chars, mix)
DB_PASSWORD=CambiarEstaPasswordFuerte2026!
DB_NAME=CosechaFrutilla

# ── Seguridad JWT ────────────────────────────────────────────
# Secret para firmar tokens JWT. Generar con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NUNCA usar el valor de ejemplo en producción.
JWT_SECRET=REEMPLAZAR_CON_64_BYTES_HEX_RANDOM

# ── Puerto del servidor Node ─────────────────────────────────
# Default 3000. En VPS detrás de Nginx reverse proxy puede quedar 3000.
PORT=3000

# ── CORS ────────────────────────────────────────────────────
# Dominio permitido para llamadas desde frontend separado.
# Si el frontend se sirve desde el mismo Express (mismo origen), poner '*'.
# En producción con dominio propio: https://app.tudominio.com
CORS_ORIGIN=*

# ── Admin inicial ────────────────────────────────────────────
# Password del primer usuario admin que se crea automáticamente si la tabla
# Usuarios está vacía. Se setea SOLO en el primer arranque, después se ignora.
# Si no se setea, usa 'admin123' con warning crítico (NO usar en producción).
ADMIN_DEFAULT_PASSWORD=CambiarEnPrimerLogin2026!
